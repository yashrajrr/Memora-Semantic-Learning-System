OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1:free
WHISPER_MODEL=tiny
FLASK_SECRET_KEY=change-this-secret-key
APP_ENV=development
PORT=5000
REQUIRE_DATABASE=false
# Use the Supabase Postgres connection string. Prefer the transaction pooler
# for a hosted web service and keep it server-side only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Optional compatibility alias accepted by database.py
# POSTGRES_URL=
MAX_UPLOAD_MB=512
